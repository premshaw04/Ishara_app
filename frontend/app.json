{
  "expo": {
    "name": "Ishara",
    "slug": "ishara",
    "scheme": "ishara",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Ishara to securely recognize user speech",
        "NSMicrophoneUsageDescription": "Allow Ishara to access the microphone for speech-to-text"
      }
    },
    "android": {
      "package": "com.anonymous.ishara",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "plugins": [
      "expo-speech-recognition",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "99d982a8-c007-47af-94a3-e27b0e4d78c6"
      }
    }
  }
}
